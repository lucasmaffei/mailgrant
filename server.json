{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.lucasmaffei/mailgrant",
  "title": "mailgrant",
  "description": "Self-hosted email gateway for AI agents: each token gets its own IMAP/SMTP mailboxes and scopes.",
  "version": "0.6.0",
  "repository": {
    "url": "https://github.com/lucasmaffei/mailgrant",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/lucasmaffei/mailgrant:latest",
      "runtimeHint": "docker",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:8000/mcp"
      }
    }
  ]
}
