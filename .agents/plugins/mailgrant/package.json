{
  "name": "mailgrant-mcp",
  "version": "0.0.0",
  "mcpName": "io.github.lucasmaffei/mailgrant",
  "description": "stdio bridge from any MCP client to a self-hosted mailgrant gateway.",
  "type": "module",
  "bin": {
