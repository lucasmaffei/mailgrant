    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Lucas Maffei",
  "homepage": "https://github.com/lucasmaffei/mailgrant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasmaffei/mailgrant.git"
  },
  "bugs": {
    "url": "https://github.com/lucasmaffei/mailgrant/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "email",
    "imap",
    "smtp",
    "openclaw",
    "ai-agent",
    "permissions"
